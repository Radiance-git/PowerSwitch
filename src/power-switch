#!/bin/bash

set -u

readonly LOG_PREFIX="[PowerSwitch]"

log() {
    echo "$LOG_PREFIX $*"
}

error() {
    echo "$LOG_PREFIX ERROR: $*" >&2
}

shutdown() {
    log "PowerSwitch stopped"
    exit 0
}

check_dependencies() {
    local command

    for command in udevadm powerprofilesctl; do
        if ! command -v "$command" >/dev/null 2>&1; then
            error "Required command not found: $command"
            return 1
        fi
    done

    return 0
}

find_ac_adapters() {
    local device
    local device_type

    for device in /sys/class/power_supply/*; do
        [ -f "$device/type" ] || continue

        device_type="$(cat "$device/type" 2>/dev/null)" || continue

        if [ "$device_type" = "Mains" ]; then
            echo "$device"
        fi
    done
}

get_power_state() {
    local ac_adapter
    local online
    local adapter_found=0

    for ac_adapter in "$@"; do
        [ -f "$ac_adapter/online" ] || continue

        adapter_found=1

        online="$(cat "$ac_adapter/online" 2>/dev/null)" || continue

        case "$online" in
            1)
                echo "ac"
                return 0
                ;;
            0)
                ;;
            *)
                error "Unknown AC adapter status: $online"
                return 1
                ;;
        esac
    done

    if [ "$adapter_found" -eq 0 ]; then
        error "Unable to read any AC adapter status."
        return 1
    fi

    echo "battery"
    return 0
}

get_target_profile() {
    local power_state="$1"

    case "$power_state" in
        ac)
            echo "performance"
            ;;
        battery)
            echo "power-saver"
            ;;
        *)
            error "Unknown power state: $power_state"
            return 1
            ;;
    esac
}

apply_power_profile() {
    local power_state="$1"
    local target_profile
    local current_profile

    target_profile="$(get_target_profile "$power_state")" || return 1

    current_profile="$(powerprofilesctl get 2>/dev/null)" || {
        error "Failed to get current power profile."
        return 1
    }

    if [ "$current_profile" = "$target_profile" ]; then
        log "Power profile already set to: $target_profile"
        return 0
    fi

    log "Changing power profile: $current_profile -> $target_profile"

    if powerprofilesctl set "$target_profile"; then
        log "Power profile changed to: $target_profile"
        return 0
    fi

    error "Failed to set power profile to: $target_profile"
    return 1
}

update_power_profile() {
    local new_state="$1"
    local current_state="$2"

    if [ "$new_state" = "$current_state" ]; then
        return 0
    fi

    log "Power state changed: $current_state -> $new_state"

    if ! apply_power_profile "$new_state"; then
        error "Failed to apply profile for power state: $new_state"
        return 1
    fi

    return 0
}

monitor_power_events() {
    local event
    local new_state

    log "Waiting for power events..."

    while IFS= read -r event; do
        case "$event" in
            *"/power_supply/"*)
                new_state="$(get_power_state "${AC_ADAPTERS[@]}")" || {
                    error "Failed to determine current power state."
                    continue
                }

                if [ "$new_state" != "$CURRENT_STATE" ]; then
                    if update_power_profile "$new_state" "$CURRENT_STATE"; then
                        CURRENT_STATE="$new_state"
                    fi
                fi
                ;;
        esac
    done < <(
        udevadm monitor \
            --udev \
            --subsystem-match=power_supply
    )

    return 0
}

main() {
    trap shutdown SIGTERM SIGINT

    log "Starting PowerSwitch"

    check_dependencies || exit 1

    mapfile -t AC_ADAPTERS < <(find_ac_adapters)

    if [ "${#AC_ADAPTERS[@]}" -eq 0 ]; then
        error "No AC adapter found."
        exit 1
    fi

    log "Detected AC adapter(s):"

    local adapter
    for adapter in "${AC_ADAPTERS[@]}"; do
        log "  $adapter"
    done

    CURRENT_STATE="$(get_power_state "${AC_ADAPTERS[@]}")" || {
        error "Failed to determine current power state."
        exit 1
    }

    log "Current power state: $CURRENT_STATE"

    if ! apply_power_profile "$CURRENT_STATE"; then
        error "Failed to apply initial power profile."
        exit 1
    fi

    monitor_power_events
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main
fi